{
  "manifest_version": 3,
  "name": "InstTranslate",
  "version": "1.5.5",
  "description": "テキストを選択した時点で、右上に翻訳を出します。",
  "permissions": [
    "storage",
    "windows"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "InstTranslate",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/shared.js", "src/translator.js", "src/overlay.js", "src/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://translate.google.com/*",
        "https://translate.google.co.jp/*"
      ],
      "js": ["src/shared.js", "src/translate-page.js"],
      "css": ["src/translate-page.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
